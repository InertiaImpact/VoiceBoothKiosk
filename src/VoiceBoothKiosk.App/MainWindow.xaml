<Window x:Class="VoiceBoothKiosk.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:VoiceBoothKiosk.App.Controls"
        mc:Ignorable="d"
        Title="{Binding ApplicationTitle}"
        Width="1440"
        Height="900"
        MinWidth="1024"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Cursor="{Binding KioskCursor}"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.72,0.28" GradientOrigin="0.72,0.28" RadiusX="0.9" RadiusY="1.1">
                <GradientStop Color="#102744" Offset="0" />
                <GradientStop Color="{StaticResource CanvasColor}" Offset="0.68" />
            </RadialGradientBrush>
        </Grid.Background>

        <!-- Welcome / session creation -->
        <Grid Margin="54"
              Visibility="{Binding IsSessionActive, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="50" />
                <ColumnDefinition Width="0.95*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.ColumnSpan="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Panel.ZIndex="10">
                <Button Command="{Binding OpenDevicesCommand}"
                        Style="{StaticResource QuietIconButton}"
                        Margin="0,0,8,0"
                        ToolTip="Audio devices"
                        AutomationProperties.Name="Audio devices"
                        Visibility="{Binding AllowDeviceSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets" />
                </Button>
                <Button Tag="Settings"
                        IsEnabled="{Binding CanOpenConfiguration}"
                        Style="{StaticResource QuietIconButton}"
                        Margin="0,0,8,0"
                        ToolTip="Press and hold for 4 seconds to open settings"
                        AutomationProperties.Name="Settings and save locations"
                        AutomationProperties.HelpText="Press and hold for four seconds"
                        PreviewMouseLeftButtonDown="ProtectedHoldButton_PreviewMouseLeftButtonDown"
                        PreviewMouseLeftButtonUp="ProtectedHoldButton_PreviewMouseLeftButtonUp"
                        MouseLeave="ProtectedHoldButton_MouseLeave"
                        LostMouseCapture="ProtectedHoldButton_LostMouseCapture"
                        PreviewTouchDown="ProtectedHoldButton_PreviewTouchDown"
                        PreviewTouchUp="ProtectedHoldButton_PreviewTouchUp"
                        PreviewTouchMove="ProtectedHoldButton_PreviewTouchMove"
                        LostTouchCapture="ProtectedHoldButton_LostTouchCapture"
                        PreviewKeyDown="ProtectedHoldButton_PreviewKeyDown"
                        PreviewKeyUp="ProtectedHoldButton_PreviewKeyUp"
                        LostKeyboardFocus="ProtectedHoldButton_LostKeyboardFocus">
                    <Grid Width="20" Height="24">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <ProgressBar Tag="ProtectedHoldProgress" Minimum="0" Maximum="4" Value="0"
                                     Width="20" Height="3" VerticalAlignment="Bottom"
                                     Foreground="{StaticResource AccentBrush}" Background="#334C6278"
                                     Visibility="Collapsed" />
                    </Grid>
                </Button>
                <Button Tag="Exit"
                        Style="{StaticResource QuietIconButton}"
                        Opacity="0.42"
                        ToolTip="Press and hold for 4 seconds to exit"
                        AutomationProperties.Name="Exit Voice Booth"
                        AutomationProperties.HelpText="Press and hold for four seconds"
                        Visibility="{Binding ShowHoldToExit, Converter={StaticResource BooleanToVisibilityConverter}}"
                        PreviewMouseLeftButtonDown="ProtectedHoldButton_PreviewMouseLeftButtonDown"
                        PreviewMouseLeftButtonUp="ProtectedHoldButton_PreviewMouseLeftButtonUp"
                        MouseLeave="ProtectedHoldButton_MouseLeave"
                        LostMouseCapture="ProtectedHoldButton_LostMouseCapture"
                        PreviewTouchDown="ProtectedHoldButton_PreviewTouchDown"
                        PreviewTouchUp="ProtectedHoldButton_PreviewTouchUp"
                        PreviewTouchMove="ProtectedHoldButton_PreviewTouchMove"
                        LostTouchCapture="ProtectedHoldButton_LostTouchCapture"
                        PreviewKeyDown="ProtectedHoldButton_PreviewKeyDown"
                        PreviewKeyUp="ProtectedHoldButton_PreviewKeyUp"
                        LostKeyboardFocus="ProtectedHoldButton_LostKeyboardFocus">
                    <Grid Width="20" Height="24">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <ProgressBar Tag="ProtectedHoldProgress" Minimum="0" Maximum="4" Value="0"
                                     Width="20" Height="3" VerticalAlignment="Bottom"
                                     Foreground="{StaticResource AccentBrush}" Background="#334C6278"
                                     Visibility="Collapsed" />
                    </Grid>
                </Button>
            </StackPanel>

            <Grid Grid.Column="0" Margin="25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="66" Height="66">
                        <Border CornerRadius="18" Background="{StaticResource AccentDarkBrush}"
                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5"
                                Visibility="{Binding HasLogo, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <TextBlock Text="VB" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border CornerRadius="18" Background="White" Padding="6"
                                Visibility="{Binding HasLogo, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Image Source="{Binding LogoSource}" Stretch="Uniform" />
                        </Border>
                    </Grid>
                    <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ApplicationTitle}" FontSize="29" FontWeight="Bold" />
                        <TextBlock Text="{Binding ApplicationSubtitle}" FontSize="15" Foreground="{StaticResource AccentBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" MaxWidth="650" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding WelcomeInstructions}"
                               FontSize="54" FontWeight="Bold" LineHeight="61" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding WelcomeExtraContent}" Margin="0,14,30,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" FontSize="16" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,7" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>

            <Border Grid.Column="2" Background="#E6111D30" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="22" Padding="46" MaxWidth="650" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Start a new session" FontSize="32" FontWeight="Bold" />
                    <TextBlock Text="Give this recording session a recognizable name."
                               FontSize="17" Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,34" />

                    <TextBlock Text="SESSION NAME" Style="{StaticResource LabelText}" />
                    <TextBox x:Name="SessionNameTextBox"
                             Text="{Binding SessionNameInput, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="100"
                             AutomationProperties.Name="Session name"
                             KeyDown="SessionNameTextBox_KeyDown" />
                    <TextBlock Text="{Binding SessionNameHelp}" FontSize="14" Foreground="{StaticResource MutedTextBrush}" Margin="2,9,0,0" />

                    <Border Background="#80101D30" CornerRadius="8" Padding="13" Margin="0,25,0,0"
                            Visibility="{Binding HasSessionNamePreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="SAVE FOLDER PREVIEW" Style="{StaticResource LabelText}" FontSize="12" />
                            <TextBlock Text="{Binding SessionFolderPreview}" FontSize="15" FontFamily="Cascadia Mono, Consolas" />
                        </StackPanel>
                    </Border>

                    <Button Content="Start Session  →"
                            Command="{Binding StartSessionCommand}"
                            Style="{StaticResource PrimaryButton}"
                            FontSize="20" MinHeight="64" Margin="0,34,0,0"
                            IsDefault="True"
                            ToolTip="{Binding ReadinessMessage}"
                            ToolTipService.ShowOnDisabled="True"
                            AutomationProperties.HelpText="Begin a new audio recording session" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Active recording workspace -->
        <Grid Visibility="{Binding IsSessionActive, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="82" />
                <RowDefinition Height="*" />
                <RowDefinition Height="46" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#F0101D30" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="28,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="46" Height="46">
                            <Border CornerRadius="12" Background="{StaticResource AccentDarkBrush}"
                                    Visibility="{Binding HasLogo, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <TextBlock Text="VB" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border CornerRadius="12" Background="White" Padding="4"
                                    Visibility="{Binding HasLogo, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Image Source="{Binding LogoSource}" Stretch="Uniform" />
                            </Border>
                        </Grid>
                        <StackPanel Margin="15,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentSessionName}" FontSize="22" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxWidth="650" />
                            <TextBlock Text="{Binding SessionElapsedText}" FontSize="13" Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" Background="#6618273A" CornerRadius="20" Padding="16,8"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="{Binding StatusIndicatorBrush}" Margin="0,0,9,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TransportStatus}" FontSize="14" FontWeight="Bold" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding OpenDevicesCommand}"
                                Style="{StaticResource QuietIconButton}"
                                Margin="0,0,8,0"
                                ToolTip="Audio devices"
                                AutomationProperties.Name="Audio devices"
                                Visibility="{Binding AllowDeviceSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets" />
                        </Button>
                        <Button Tag="Settings"
                                IsEnabled="{Binding CanOpenConfiguration}"
                                Style="{StaticResource QuietIconButton}"
                                Margin="0,0,8,0"
                                ToolTip="Press and hold for 4 seconds to open settings"
                                AutomationProperties.Name="Settings and save locations"
                                AutomationProperties.HelpText="Press and hold for four seconds"
                                PreviewMouseLeftButtonDown="ProtectedHoldButton_PreviewMouseLeftButtonDown"
                                PreviewMouseLeftButtonUp="ProtectedHoldButton_PreviewMouseLeftButtonUp"
                                MouseLeave="ProtectedHoldButton_MouseLeave"
                                LostMouseCapture="ProtectedHoldButton_LostMouseCapture"
                                PreviewTouchDown="ProtectedHoldButton_PreviewTouchDown"
                                PreviewTouchUp="ProtectedHoldButton_PreviewTouchUp"
                                PreviewTouchMove="ProtectedHoldButton_PreviewTouchMove"
                                LostTouchCapture="ProtectedHoldButton_LostTouchCapture"
                                PreviewKeyDown="ProtectedHoldButton_PreviewKeyDown"
                                PreviewKeyUp="ProtectedHoldButton_PreviewKeyUp"
                                LostKeyboardFocus="ProtectedHoldButton_LostKeyboardFocus">
                            <Grid Width="20" Height="24">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <ProgressBar Tag="ProtectedHoldProgress" Minimum="0" Maximum="4" Value="0"
                                             Width="20" Height="3" VerticalAlignment="Bottom"
                                             Foreground="{StaticResource AccentBrush}" Background="#334C6278"
                                             Visibility="Collapsed" />
                            </Grid>
                        </Button>
                        <Button Tag="Exit"
                                Style="{StaticResource QuietIconButton}"
                                Margin="0,0,12,0"
                                Opacity="0.42"
                                ToolTip="Press and hold for 4 seconds to exit"
                                AutomationProperties.Name="Exit Voice Booth"
                                AutomationProperties.HelpText="Press and hold for four seconds"
                                Visibility="{Binding ShowHoldToExit, Converter={StaticResource BooleanToVisibilityConverter}}"
                                PreviewMouseLeftButtonDown="ProtectedHoldButton_PreviewMouseLeftButtonDown"
                                PreviewMouseLeftButtonUp="ProtectedHoldButton_PreviewMouseLeftButtonUp"
                                MouseLeave="ProtectedHoldButton_MouseLeave"
                                LostMouseCapture="ProtectedHoldButton_LostMouseCapture"
                                PreviewTouchDown="ProtectedHoldButton_PreviewTouchDown"
                                PreviewTouchUp="ProtectedHoldButton_PreviewTouchUp"
                                PreviewTouchMove="ProtectedHoldButton_PreviewTouchMove"
                                LostTouchCapture="ProtectedHoldButton_LostTouchCapture"
                                PreviewKeyDown="ProtectedHoldButton_PreviewKeyDown"
                                PreviewKeyUp="ProtectedHoldButton_PreviewKeyUp"
                                LostKeyboardFocus="ProtectedHoldButton_LostKeyboardFocus">
                            <Grid Width="20" Height="24">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <ProgressBar Tag="ProtectedHoldProgress" Minimum="0" Maximum="4" Value="0"
                                             Width="20" Height="3" VerticalAlignment="Bottom"
                                             Foreground="{StaticResource AccentBrush}" Background="#334C6278"
                                             Visibility="Collapsed" />
                            </Grid>
                        </Button>
                        <Button Content="End Session" Command="{Binding OpenEndSessionCommand}" Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding LeftWorkspaceWidth}" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="{Binding RightWorkspaceWidth}" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="{Binding ClipRailColumn}" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="14" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="4,3,4,15">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="CLIPS" Style="{StaticResource LabelText}" />
                                <TextBlock Text="{Binding ClipCountText}" FontSize="13" Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="＋" ToolTip="New clip" Command="{Binding NewClipCommand}"
                                    Style="{StaticResource IconButton}" AutomationProperties.Name="New clip" />
                        </Grid>

                        <ListBox x:Name="ClipListBox" Grid.Row="1" ItemsSource="{Binding Clips}" SelectedItem="{Binding SelectedClip, Mode=TwoWay}"
                                 AutomationProperties.Name="Session clips">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="30" Height="30" CornerRadius="15" Background="#243A53" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Ordinal}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,8,0">
                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <TextBlock Text="{Binding DurationText}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                                <TextBlock Text="  •  " FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                                <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <Button Content="✎" ToolTip="Rename clip" Style="{StaticResource IconButton}" Padding="6" MinWidth="36" MinHeight="36"
                                                    Command="{Binding DataContext.BeginRenameClipCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" AutomationProperties.Name="Rename clip" />
                                            <Button Content="×" ToolTip="Delete clip" Style="{StaticResource IconButton}" Padding="6" MinWidth="36" MinHeight="36" Margin="5,0,0,0"
                                                    Command="{Binding DataContext.DeleteClipCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" AutomationProperties.Name="Delete clip" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Button Grid.Row="2" Content="＋  New Clip" Command="{Binding NewClipCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="0,12,0,0" />
                    </Grid>
                </Border>

                <Grid Grid.Column="{Binding MainWorkspaceColumn}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="4,0,4,13">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="CURRENT CLIP" Style="{StaticResource LabelText}" />
                            <TextBox x:Name="ClipNameTextBox" Text="{Binding SelectedClip.Name, UpdateSourceTrigger=LostFocus}"
                                     MaxLength="80" FontSize="21" FontWeight="SemiBold" MaxWidth="680" HorizontalAlignment="Left"
                                     MinWidth="420" IsEnabled="{Binding CanEditClipName}" LostKeyboardFocus="ClipNameTextBox_LostKeyboardFocus"
                                     AutomationProperties.Name="Current clip name" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding SelectedDurationText}" FontFamily="Cascadia Mono, Consolas"
                                   FontSize="28" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="20,0,0,9" />
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="4,0,4,12">
                        <TextBlock Text="{Binding RecordingInstructions}" Foreground="{StaticResource MutedTextBrush}" FontSize="15" />
                        <ItemsControl ItemsSource="{Binding RecordingExtraContent}" Margin="0,5,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" Foreground="{StaticResource MutedTextBrush}" FontSize="13" Margin="0,0,0,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <controls:WaveformTimelineControl x:Name="WaveformControl" Grid.Row="2"
                                                      Peaks="{Binding WaveformPeaks}"
                                                      Duration="{Binding SelectedDuration}"
                                                      Playhead="{Binding Playhead}"
                                                      IsRecording="{Binding IsRecording}"
                                                      WaveformBrush="{Binding WaveformBrush}"
                                                      RecordingBrush="{Binding RecordingWaveformBrush}"
                                                      WaveformBackground="{Binding WaveformBackgroundBrush}"
                                                      SeekRequested="WaveformControl_SeekRequested"
                                                      AutomationProperties.Name="Waveform and playback timeline" />

                    <Grid Grid.Row="3" Margin="6,13,6,15">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="INPUT" Style="{StaticResource LabelText}" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <ProgressBar Width="190" Height="13" Minimum="0" Maximum="1" Value="{Binding InputLevel, Mode=OneWay}"
                                         Foreground="{Binding InputLevelBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding InputLevelText}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                       Foreground="{StaticResource MutedTextBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding ContextMessage}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="14" />
                    </Grid>

                    <TextBlock Grid.Row="3" Text="{Binding InputLevelStatus}" Foreground="{Binding InputLevelBrush}"
                               FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-2" />

                    <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Button Content="↺  New Take" Command="{Binding NewTakeCommand}" Style="{StaticResource DangerButton}"
                                    HorizontalAlignment="Left" MinWidth="145" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="|◀" ToolTip="Return to start" Command="{Binding ReturnToStartCommand}" Style="{StaticResource IconButton}" />
                                <Button Content="{Binding PlayButtonText}" Command="{Binding PlayPauseCommand}" Style="{StaticResource SecondaryButton}"
                                        MinWidth="115" Margin="10,0" />
                                <Button Content="{Binding RecordButtonText}" Command="{Binding RecordCommand}" Style="{StaticResource RecordButton}" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="New Clip  →" Command="{Binding NewClipCommand}" Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Right" MinWidth="145" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Background="#F0101D30" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="●" Foreground="{Binding AutosaveBrush}" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding AutosaveMessage}" FontSize="13" Foreground="{StaticResource MutedTextBrush}" />
                        <Button Content="Undo" Command="{Binding UndoCommand}" Style="{StaticResource SecondaryButton}"
                                Padding="10,4" MinHeight="32" Margin="14,0,0,0"
                                Visibility="{Binding CanUndo, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding FreeSpaceText}" FontSize="13" Foreground="{StaticResource MutedTextBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <!-- Audio device drawer -->
        <Grid Panel.ZIndex="20" Background="#B0000712"
              Visibility="{Binding IsDevicePanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="530" HorizontalAlignment="Right" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Padding="38">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Audio Devices" FontSize="31" FontWeight="Bold" />
                            <TextBlock Text="{Binding DeviceInstructions}"
                                       FontSize="15" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0" />
                            <ItemsControl ItemsSource="{Binding DeviceExtraContent}" Margin="0,7,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Text}" FontSize="13" Foreground="{StaticResource MutedTextBrush}" /></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <Button Grid.Column="1" Content="×" Command="{Binding CloseDevicesCommand}" Style="{StaticResource IconButton}" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" Margin="0,38,0,12" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="MICROPHONE / INPUT" Style="{StaticResource LabelText}" />
                        <ComboBox ItemsSource="{Binding InputDevices}" SelectedItem="{Binding SelectedInputDevice}"
                                  DisplayMemberPath="DisplayName" AutomationProperties.Name="Input device" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions>
                            <ProgressBar Height="20" Minimum="0" Maximum="1" Value="{Binding InputLevel, Mode=OneWay}"
                                         Foreground="{Binding InputLevelBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding InputLevelText}" FontFamily="Cascadia Mono, Consolas"
                                       TextAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{Binding InputLevelStatus}" FontSize="13" Foreground="{Binding InputLevelBrush}"
                                   MinHeight="20" Margin="0,7,0,0" TextWrapping="Wrap" />
                        <Button Content="{Binding InputTestButtonText}" Command="{Binding TestInputCommand}"
                                Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                Padding="16,9" MinHeight="44" MinWidth="170" Margin="0,8,0,0"
                                ToolTip="This is a level-only microphone test. It does not play microphone audio through the speakers." />
                        <TextBlock Text="{Binding InputTestMessage}" FontSize="13" Foreground="{Binding InputTestStatusBrush}"
                                   Margin="0,8,0,0" TextWrapping="Wrap" />

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,30" />

                        <TextBlock Text="HEADPHONES / SPEAKERS" Style="{StaticResource LabelText}" />
                        <ComboBox ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SelectedOutputDevice}"
                                  DisplayMemberPath="DisplayName" AutomationProperties.Name="Output device" />
                        <Grid Margin="0,14,0,0" Visibility="{Binding AllowOutputVolumeControl, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Slider Minimum="0" Maximum="1" Value="{Binding OutputVolume, UpdateSourceTrigger=PropertyChanged}"
                                    VerticalAlignment="Center" AutomationProperties.Name="Playback volume" />
                            <TextBlock Grid.Column="1" Text="{Binding OutputVolumeText}" Width="48" TextAlignment="Right"
                                       FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center" />
                        </Grid>
                        <Button Content="{Binding OutputTestButtonText}" Command="{Binding TestOutputCommand}" Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Left" Margin="0,14,0,0" />
                        <TextBlock Text="{Binding OutputTestMessage}" FontSize="13" Foreground="{Binding OutputTestStatusBrush}"
                                   Margin="0,9,0,0" TextWrapping="Wrap" />

                        <Border Background="#13283F" CornerRadius="9" Padding="16" Margin="0,28,0,0">
                            <TextBlock Text="Device changes take effect on the next recording or playback. Devices cannot be changed while audio is active."
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="14" />
                        </Border>
                    </StackPanel>
                    </ScrollViewer>

                    <Button Grid.Row="2" Content="Done" Command="{Binding CloseDevicesCommand}" Style="{StaticResource PrimaryButton}" />
                </Grid>
            </Border>
        </Grid>

        <!-- End-session review -->
        <Grid Panel.ZIndex="25" Background="#D0000712"
              Visibility="{Binding IsEndSessionPanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="720" MaxHeight="760" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="18" Padding="38" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Finish this session?" FontSize="34" FontWeight="Bold" />
                        <TextBlock Text="{Binding EndSessionPanelInstructions}"
                                   FontSize="16" Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,0" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding EndSessionExtraContent}" Margin="0,7,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Text}" FontSize="14" Foreground="{StaticResource MutedTextBrush}" /></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,30,0,25">
                        <StackPanel>
                            <Border Background="#13283F" CornerRadius="10" Padding="18">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="SESSION" Style="{StaticResource LabelText}" />
                                        <TextBlock Text="{Binding CurrentSessionName}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="RECORDINGS" Style="{StaticResource LabelText}" />
                                        <TextBlock Text="{Binding ExportClipCountText}" FontSize="16" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="TOTAL TIME" Style="{StaticResource LabelText}" />
                                        <TextBlock Text="{Binding SessionRecordedDurationText}" FontFamily="Cascadia Mono, Consolas" FontSize="16" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <StackPanel Visibility="{Binding HasRecordedAudio, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="SAVE DESTINATION" Style="{StaticResource LabelText}" Margin="0,28,0,7" />
                                <ComboBox ItemsSource="{Binding Destinations}" SelectedItem="{Binding SelectedDestination}"
                                          DisplayMemberPath="DisplayName" AutomationProperties.Name="Save destination" />

                                <TextBlock Text="OUTPUT FILES" Style="{StaticResource LabelText}" Margin="0,28,0,7" />
                                <ItemsControl ItemsSource="{Binding ExportFilePreviews}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#80101D30" CornerRadius="7" Padding="12,8" Margin="0,0,0,6">
                                                <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="13" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="A matching lossless WAV for each clip will also be saved inside the session folder's Raw subfolder."
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="13" Margin="2,5,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="Existing recordings are never overwritten. A numbered suffix is added when needed."
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="13" Margin="2,5,0,0" />
                            </StackPanel>

                            <Border Background="#13283F" CornerRadius="10" Padding="18" Margin="0,22,0,0"
                                    Visibility="{Binding HasRecordedAudio, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <TextBlock Text="Nothing will be exported. The temporary local session will be removed."
                                           FontSize="15" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Button Content="Keep Recording" Command="{Binding CloseEndSessionCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" />
                        <Button Grid.Column="1" Content="{Binding EndSessionPrimaryButtonText}" Command="{Binding ExportAndEndCommand}"
                                Style="{StaticResource PrimaryButton}" MinWidth="320" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Busy/export overlay -->
        <Grid Panel.ZIndex="30" Background="#E008111F"
              Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="560">
                <TextBlock Text="{Binding BusyTitle}" FontSize="34" FontWeight="Bold" TextAlignment="Center" />
                <TextBlock Text="{Binding BusyMessage}" FontSize="17" Foreground="{StaticResource MutedTextBrush}"
                           TextAlignment="Center" Margin="0,13,0,26" />
                <ProgressBar Height="16" Minimum="0" Maximum="1" Value="{Binding BusyProgress, Mode=OneWay}" IsIndeterminate="{Binding IsBusyIndeterminate}" />
                <TextBlock Text="Do not turn off the kiosk while recordings are being saved."
                           FontSize="13" Foreground="{StaticResource MutedTextBrush}" TextAlignment="Center" Margin="0,18,0,0" />
            </StackPanel>
        </Grid>

        <!-- Successful export -->
        <Grid Panel.ZIndex="40" Background="{StaticResource CanvasBrush}"
              Visibility="{Binding IsSuccessVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="700">
                <Border Width="96" Height="96" CornerRadius="48" Background="#183E35" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="2">
                    <TextBlock Text="✓" Foreground="{StaticResource SuccessBrush}" FontSize="52" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Session saved" FontSize="48" FontWeight="Bold" TextAlignment="Center" Margin="0,28,0,0" />
                <TextBlock Text="{Binding SuccessMessage}" FontSize="19" Foreground="{StaticResource MutedTextBrush}"
                           TextAlignment="Center" LineHeight="29" Margin="0,15,0,28" />
                <Button Content="Done" Command="{Binding FinishSuccessCommand}" Style="{StaticResource PrimaryButton}" MinWidth="220" />
            </StackPanel>
        </Grid>

        <!-- Privacy handoff warning for an unattended active session -->
        <Grid Panel.ZIndex="50" Background="#F208111F"
              Visibility="{Binding IsInactivityWarningVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="650" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource WarningBrush}"
                    BorderThickness="2" CornerRadius="20" Padding="42" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Are you still recording?" FontSize="38" FontWeight="Bold" TextAlignment="Center" />
                    <TextBlock Text="{Binding InactivityCountdownText}" FontSize="20" Foreground="{StaticResource WarningBrush}"
                               FontWeight="SemiBold" TextAlignment="Center" Margin="0,18,0,0" />
                    <TextBlock Text="If nobody responds, this session will be hidden from the public kiosk and retained for administrator recovery."
                               FontSize="15" Foreground="{StaticResource MutedTextBrush}" TextAlignment="Center" LineHeight="24" Margin="0,15,0,28" />
                    <Button Content="I’m still here" Command="{Binding ContinueSessionCommand}"
                            Style="{StaticResource PrimaryButton}" MinWidth="240" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
